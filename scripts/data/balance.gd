class_name Balance
extends RefCounted
## ════════════════════════════════════════════════════════════════════
##  本文件里的每一个数字都是【临时值】，不是定稿。
## ════════════════════════════════════════════════════════════════════
##
## 设计文档把这些项列为「另定 / 尚未拍板」。这里的取值只为让初版能跑起来、
## 能试手感，业主拍板后直接改这一个文件即可，逻辑代码不写死任何数值。
##
## 临时值仍遵守文档已定的原则，tests/test_runner.gd 会逐条检查：
##   - 力量成长偏肝：单次举重加得少，量大才明显变强，力量有上限；
##   - 出手时机与落点波动对抛距只做小幅修正，压不过力量；
##   - 8 个展示台全部升满，收益仍低于自己去钓鱼；
##   - 离线展示最多结算 4 小时（该上限是已拍板内容，放在 content.gd）。

# ── 力量与举重 ─────────────────────────────────────────────────────
## 玩家初始力量。
const START_STRENGTH := 0
## 力量上限。
const STRENGTH_CAP := 20000
## 各档哑铃每完成一次举重增加的力量。
const LIFT_GAIN: Array[int] = [1, 2, 4, 7]
## 一次完整举重动作的时长（秒）。动作做完才结算，期间再点无效，也不能走动。
const LIFT_DURATION := 0.8
## 各档哑铃价格。
const DUMBBELL_PRICE: Array[int] = [500, 4000, 30000, 180000]

# ── 抛距：文档「计算方案」里的参数 ─────────────────────────────────
##   p = clamp(P / Pcap, 0, 1)
##   M(P) = D0 + (Dcap - D0) × p^γ
##   D = M(P) × [1 - a × (1 - Q) - b × R]，R = (U1 + U2) / 2
## 零力量时的最大抛距（米）。
const CAST_D0 := 7.0
## 满力量时的最大抛距（米），等于 6 区总进深。
const CAST_DCAP := 48.0
## 力量映射到抛距的曲线指数。
const CAST_GAMMA := 0.6
## 出手质量对距离的修正系数（须保持小幅）。
const CAST_A := 0.08
## 自然落点波动系数（须保持小幅）。
const CAST_B := 0.10
## 落点左右散布的半宽（米）。只影响画面，不影响分区。
const CAST_LATERAL_SPREAD := 3.0
## 浮标飞行时长（秒）。
const CAST_FLIGHT_TIME := 0.55

# ── 水域 ───────────────────────────────────────────────────────────
## 6 个长方形水域各自的进深（米），由近到远。
const ZONE_DEPTH: Array[float] = [8.0, 8.0, 8.0, 8.0, 8.0, 8.0]
## 水域宽度（米）。
const ZONE_WIDTH := 24.0

# ── 蓄力 ───────────────────────────────────────────────────────────
## 蓄力条从空到满再回到空的一个来回（秒）。松手时的填充比例就是出手质量 Q。
const CHARGE_PERIOD := 1.6

# ── 运气与转盘出鱼权重 ─────────────────────────────────────────────
## 出手质量 Q 折算成运气的系数。
const LUCK_FROM_QUALITY := 1.0
## 各档鱼竿自带的运气。
const ROD_LUCK: Array[float] = [0.0, 0.3, 0.6, 1.0]
## 每点运气让稀有度每高一档的鱼权重提高多少。黑铁不受运气影响。
const LUCK_RARITY_STEP := 0.35
## 各稀有度的基础出鱼权重。
const RARITY_WEIGHT: Array[float] = [100.0, 45.0, 20.0, 8.0]
## 鱼出现在紧邻自己倾向区一格的水域时，权重乘以这个系数；再远就不出现。
const ADJACENT_ZONE_FACTOR := 0.2
## 选鱼滚轮从开始滚到停下的时长（秒）。滚轮自己停。
const WHEEL_SPIN_TIME := 1.6
## 滚轮停下后停留多久再开始收线（秒）。
const WHEEL_HOLD_TIME := 0.5

# ── 走动 ───────────────────────────────────────────────────────────
## 角色走路的速度（米/秒）。
const WALK_SPEED := 6.5

# ── 收线与巨鱼追逐 ─────────────────────────────────────────────────
## 进度用 0–1 表示：0 是咬钩点，1 是上岸。与实际抛距无关，远近都一样短。
## 用最低档鱼竿把各稀有度的鱼拖上岸需要点几下。
const REEL_TAPS: Array[float] = [10.0, 13.0, 17.0, 22.0]
## 各档鱼竿的收线速度倍率（每点一下的进度按此放大）。
const ROD_REEL_SPEED: Array[float] = [1.0, 1.25, 1.55, 1.9]
## 开始收线时巨鱼落后目标鱼多少进度。巨鱼在收线开始的同时开始追。
const CHASE_GAP := 0.4
## 巨鱼每秒追多少进度。
const CHASE_SPEED := 0.26
## 巨鱼单帧最多前进的时间（秒）。切到后台再回来时，追逐等于暂停，不会瞬间吃掉鱼。
const CHASE_MAX_STEP := 0.1
## 结果横幅停留时长（秒）。
const RESULT_TIME := 1.2
## 结果出现后多久才接受下一次蓄力（秒），防止连点收线时误触投竿。
const RESULT_INPUT_LOCK := 0.5

# ── 价格 ───────────────────────────────────────────────────────────
## 各鱼种未升级时的卖价。
const FISH_PRICE := {
	"matou_tiao": 50,
	"shifeng_hu": 60,
	"huayi_ji": 70,
	"lanyao_nian": 80,
	"qingtai_qiu": 180,
	"tiaolang_bai": 210,
	"pushan_bian": 240,
	"huanggu_lang": 550,
	"wandao_bo": 620,
	"guyan_qing": 700,
	"yueya_ji": 1800,
	"xuelin_fang": 2200,
}
## 各档鱼竿价格。最低档是开局自带的。
const ROD_PRICE: Array[int] = [0, 3000, 25000, 150000]
## 升级过的鱼每高一级，卖价比未升级的同种鱼多这个比例（须保持轻微）。
const SELL_PREMIUM_PER_LEVEL := 0.02

# ── 背包 ───────────────────────────────────────────────────────────
## 背包容量。满包时不能投竿，也不能把展示中的鱼下架。暂不提供扩容。
const BACKPACK_CAPACITY := 20

# ── 展示 ───────────────────────────────────────────────────────────
## 展示等级上限。
const DISPLAY_MAX_LEVEL := 10
## 1 级时每秒收益 = 卖价 × 这个比例。
const DISPLAY_RATE := 0.0005
## 每升一级，每秒收益比 1 级多这个比例。
const DISPLAY_LEVEL_STEP := 0.4
## 从 n 级升到 n+1 级的费用 = 卖价 × 系数 × n^指数。
const UPGRADE_COST_FACTOR := 4.0
const UPGRADE_COST_POWER := 1.5
## 距上次结算超过这么久（秒），就当作离线或切到后台，结算后弹出收益提示。
const OFFLINE_NOTICE_GAP := 10.0
